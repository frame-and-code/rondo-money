# Copy this file to .env and adjust values as needed (`pnpm env:setup` does the copy,
# along with generating apps/web/.env.local from its 1Password template).
# .env is git-ignored; .env.example is committed.

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL="postgresql://ffai:ffai_dev_secret@127.0.0.1:5432/ffai_dev?schema=public"

# Browser origin allowed to call the API (CORS). Locally @ffai/web runs on :3001;
# on Railway point this at the deployed web URL. Defaults to http://localhost:3001.
WEB_ORIGIN="http://localhost:3001"
