# Copy this file to .env and adjust values as needed (`pnpm env:setup` does the copy,
# along with generating apps/web/.env.local from its 1Password template).
# .env is git-ignored; .env.example is committed.

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL="postgresql://rondo:rondo_dev_secret@127.0.0.1:5432/rondo_dev?schema=public"

# Which environment this is: development (the default when unset), test or production.
# Nothing else is accepted — the api refuses to boot on an unrecognised value rather than
# guess. It decides whether the api serves its API documentation at /docs (everywhere except
# production). Leave it unset locally; on Railway see docs/deploy-railway.md, where it matters
# because the Docker image sets NODE_ENV=production itself.
# NODE_ENV="development"

# The web app's origin. Two uses, both exact-match: the API's CORS allowance, and the `azp`
# claim every Clerk session token must carry (F1.3) — so a wrong value means 401 everywhere,
# not a CORS error. Locally @rondo/web runs on :3001; on Railway point this at the deployed
# web URL. The api refuses to start without it.
WEB_ORIGIN="http://localhost:3001"
