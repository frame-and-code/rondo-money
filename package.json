{
  "name": "rondo-money",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Rondo Money — zero-based budgeting app. Monorepo on Turborepo + pnpm.",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "env:setup": "./setup-env.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rondo/db run db:generate",
    "db:migrate": "pnpm --filter @rondo/db run db:migrate",
    "db:deploy": "pnpm --filter @rondo/db run db:deploy",
    "prepare": "husky",
    "postinstall": "pnpm --filter @rondo/db run db:generate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,jsonc,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@rondo/config": "workspace:*",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  }
}
