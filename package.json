{
  "name": "ffai",
  "version": "0.0.0",
  "private": true,
  "description": "Fin Flow AI — zero-based budgeting app. Monorepo on Turborepo + pnpm.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ffai/db run db:generate",
    "db:migrate": "pnpm --filter @ffai/db run db:migrate",
    "prepare": "husky",
    "postinstall": "pnpm --filter @ffai/db run db:generate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,jsonc,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@ffai/config": "workspace:*",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18"
  }
}
