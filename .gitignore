# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Written by Next on every run, and differently by each: `next dev` points it at
# .next/dev/types, `next build` at .next/types. Tracking it meant a file that showed up as
# modified after every local run and occasionally got swept into a commit (F1.10). Next says
# to keep it out of version control itself — node_modules/next/dist/docs/01-app/
# 03-api-reference/05-config/02-typescript.md — and nothing needs it committed: the types it
# references are regenerated by the build that consumes them.
apps/web/next-env.d.ts

# Generated code. Not a blanket rule: what is regenerated on every install stays out, what
# is a reviewable contract stays in.
# - the Prisma client is rewritten by `db:generate` on every postinstall — never committed;
# - packages/api-client/src/generated IS committed (F1.4): it is generated from
#   apps/api/openapi.json, and committing both is what turns an API change into a diff a
#   reviewer can see, and what the drift check compares against.
packages/db/src/generated/

