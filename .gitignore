# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Generated code. Not a blanket rule: what is regenerated on every install stays out, what
# is a reviewable contract stays in.
# - the Prisma client is rewritten by `db:generate` on every postinstall — never committed;
# - packages/api-client/src/generated IS committed (F1.4): it is generated from
#   apps/api/openapi.json, and committing both is what turns an API change into a diff a
#   reviewer can see, and what the drift check compares against.
packages/db/src/generated/

# Turborepo
.turbo/

# Test / coverage
coverage/
playwright-report/
test-results/

# Environment
.env
.env.*
!.env.example
# op:// template for setup-env.sh (contains no secrets)
!.env.local.tpl

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors / IDE
.idea/
.vscode/
*.swp

# Claude Code — personal permission grants; the shared setup in .claude/ is committed
.claude/settings.local.json
