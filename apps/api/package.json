{
  "name": "@rondo/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch --exec \"node --watch-path=../../packages/types/dist --watch-path=../../packages/db/dist\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi/generate.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.mjs --runInBand"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@rondo/db": "workspace:*",
    "@rondo/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.28",
    "@rondo/config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.1.1",
    "typescript": "^6.0.3"
  }
}
