{
  "name": "@rondo/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "predev": "test -d ../../packages/types/dist -a -d ../../packages/db/dist || { echo 'Start the api through turbo, pnpm dev --filter=@rondo/api, which builds the packages this watches.' >&2; exit 1; }",
    "dev": "nest start --watch --exec \"node --watch-path=../../packages/types/dist --watch-path=../../packages/db/dist\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi/generate.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --passWithNoTests",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.integration.config.mjs --runInBand"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@rondo/db": "workspace:*",
    "@rondo/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@rondo/config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3"
  }
}
