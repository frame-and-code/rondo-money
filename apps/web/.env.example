# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored; this .env.example is committed.

# Base URL of the @ffai/api backend. Exposed to the browser, so it must be NEXT_PUBLIC_*.
# Locally the API runs on :3000 (see apps/api); on Railway point this at the deployed API.
NEXT_PUBLIC_API_URL="http://localhost:3000"
